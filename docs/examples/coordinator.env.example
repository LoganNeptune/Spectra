# Example only. Supply actual secrets through your existing private environment.
# Do not source this example over an already configured environment.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=
# Logged-in agent CLI: codex, claude, grok, or cursor. Default is codex.
SPECTRA_BACKEND=codex
# Shared Full Access setting. If absent, SPECTRA_CODEX_FULL_ACCESS remains the fallback.
SPECTRA_FULL_ACCESS=1
SPECTRA_CLAUDE_COMMAND=claude
SPECTRA_GROK_COMMAND=grok
# Use an actual Cursor executable: Grok may also install an unrelated `agent` alias.
SPECTRA_CURSOR_COMMAND=cursor-agent
# Leave blank to use each CLI's own default model. SPECTRA_MODEL remains Codex-only.
SPECTRA_CLAUDE_MODEL=
SPECTRA_GROK_MODEL=
SPECTRA_CURSOR_MODEL=
SPECTRA_CLAUDE_REASONING_EFFORT=
SPECTRA_GROK_REASONING_EFFORT=
# Use the server user's existing Codex ChatGPT login; no OpenAI API key required.
SPECTRA_CODEX_COMMAND=codex
# Efficient starting point for routine scheduling and conversation (subject to account access).
SPECTRA_MODEL=gpt-6-luna
SPECTRA_REASONING_EFFORT=low
# User-requested Full Access: commands run without Codex sandbox/approval prompts.
# Set to 0 to return to the read-only worker.
SPECTRA_CODEX_FULL_ACCESS=1
# Full transcript limit; refuse larger context rather than silently dropping messages.
SPECTRA_TRANSCRIPT_MAX_BYTES=200000
SPECTRA_TRANSCRIPT_PATH=runtime/messages.txt
# User-selected Eastern Time; follows EST and EDT automatically.
SPECTRA_TIMEZONE=America/New_York
SPECTRA_GOOGLE_TOKEN_FILE=runtime/google-auth/token-rw.json
SPECTRA_GOOGLE_CALENDAR_ID=primary
SPECTRA_CALENDAR_DAYS=14
# Set to 1 to allow confirmed calendar writes. Still requires --live for the process.
SPECTRA_CALENDAR_WRITE=0
# Automatic even-hour messages additionally require SPECTRA_LIVE=1 in cron.
SPECTRA_SCHEDULED_CHECKIN=0
